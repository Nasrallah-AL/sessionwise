{
  "name": "sessionwise",
  "version": "0.1.2",
  "description": "Analyze, understand, and optimize AI sessions.",
  "type": "module",
  "author": "Nasr Shaer",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nasrallah-AL/sessionwise.git"
  },
  "bugs": "https://github.com/Nasrallah-AL/sessionwise/issues",
  "bin": {
    "sessionwise": "dist/cli.js",
    "sw": "dist/cli.js",
    "wise": "dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "build": "tsup src/index.ts src/cli.ts --format esm --dts --clean",
    "check": "npm run typecheck && npm test && npm run build",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "ai",
    "agents",
    "llm",
    "observability",
    "optimization",
    "sessions"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.3",
    "vitest": "^3.1.0"
  },
  "dependencies": {
    "jevctl": "^0.2.1"
  }
}
